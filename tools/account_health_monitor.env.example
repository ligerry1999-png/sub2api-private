# Sub2API account health monitor config.
#
# 推荐方式：飞书群聊 -> 群设置 -> 群机器人 -> 添加自定义机器人。
# 把两个人拉进同一个群，只需要配置一个 FEISHU_WEBHOOK。

SUB2API_CONTAINER=sub2api-private
TIMEZONE=Asia/Shanghai
STATE_FILE=/opt/sub2api-monitor/state.json

# 飞书自定义机器人 Webhook。没有配置时只能 dry-run，不会发送。
FEISHU_WEBHOOK=

# 如果飞书机器人开启了“签名校验”，把签名密钥填这里；没开启就留空。
FEISHU_SECRET=

# 每次定时都发正常报告；如果只想异常才提醒，改成 false。
SEND_WHEN_OK=true

# true 表示账号状态没有变化就不重复发；false 表示每次定时都发。
SEND_ONLY_ON_CHANGE=false

# 没有分组的账号也算需要处理。建议保持 true，避免新导入账号忘记放进分组。
REQUIRE_GROUP=true

# 报告里最多展开多少条异常账号。
MAX_ITEMS=20

# 距离到期多少天以内开始提醒。
WARN_EXPIRE_DAYS=7
