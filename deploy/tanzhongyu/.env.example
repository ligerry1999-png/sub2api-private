BIND_HOST=127.0.0.1
SERVER_PORT=18080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_DB=sub2api
REDIS_PASSWORD=
REDIS_DB=0

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=replace-with-generated-admin-password

JWT_SECRET=replace-with-generated-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-generated-totp-key

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false

GATEWAY_FORCE_CODEX_CLI=true
GATEWAY_RESPONSE_HEADER_TIMEOUT=1200
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
GATEWAY_IMAGE_WORKER_ENABLED=false
GATEWAY_IMAGE_WORKER_BASE_URL=http://chatgpt2api:80/internal/v1
GATEWAY_IMAGE_WORKER_TOKEN=replace-with-shared-internal-token
GATEWAY_IMAGE_WORKER_FALLBACK_ENABLED=true
GATEWAY_IMAGE_WORKER_TIMEOUT_SECONDS=1200

IMAGE_LOGS_CLEANUP_ENABLED=true
IMAGE_LOGS_RETENTION_DAYS=7
IMAGE_LOGS_CLEANUP_INTERVAL_SECONDS=3600
IMAGE_LOGS_CLEANUP_BATCH_SIZE=500
GATEWAY_ASYNC_IMAGE_QUEUE_ENABLED=true
GATEWAY_ASYNC_IMAGE_QUEUE_MAX_PENDING_TASKS=2000
GATEWAY_ASYNC_IMAGE_QUEUE_MAX_PENDING_BYTES=5368709120
GATEWAY_ASYNC_IMAGE_QUEUE_WORKER_CEILING=64
GATEWAY_ASYNC_IMAGE_QUEUE_MAX_ATTEMPTS=8
GATEWAY_ASYNC_IMAGE_QUEUE_RETRY_BASE_SECONDS=3
GATEWAY_ASYNC_IMAGE_QUEUE_RETRY_MAX_SECONDS=60
GATEWAY_ASYNC_IMAGE_QUEUE_LEASE_TTL_SECONDS=2100
GATEWAY_ASYNC_IMAGE_QUEUE_STALE_AFTER_SECONDS=2400
GATEWAY_ASYNC_IMAGE_QUEUE_READY_KEY=image_jobs:queue:ready
GATEWAY_ASYNC_IMAGE_QUEUE_DELAYED_KEY=image_jobs:queue:delayed
GATEWAY_ASYNC_IMAGE_QUEUE_ACTIVE_KEY=image_jobs:queue:active
GATEWAY_ASYNC_IMAGE_QUEUE_PAUSE_KEY=image_jobs:queue:paused
GATEWAY_ASYNC_IMAGE_QUEUE_INFLIGHT_KEY_PREFIX=image_jobs:queue:inflight:
GATEWAY_ASYNC_IMAGE_QUEUE_IDEMPOTENCY_KEY_PREFIX=image_jobs:queue:idem:
IMAGE_JOBS_RETENTION_DAYS=2
CHATGPT2API_IMAGES_RETENTION_DAYS=3
