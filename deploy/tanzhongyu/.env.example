BIND_HOST=127.0.0.1
SERVER_PORT=18080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
SUB2API_IMAGE=weishaw/sub2api:latest
SUB2API_DATA_DIR=./data
SUB2API_POSTGRES_DATA_DIR=./postgres_data
SUB2API_REDIS_DATA_DIR=./redis_data

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_DB=sub2api
REDIS_PASSWORD=
REDIS_DB=0

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=replace-with-generated-admin-password

JWT_SECRET=replace-with-generated-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-generated-totp-key

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false

GATEWAY_FORCE_CODEX_CLI=true
GATEWAY_RESPONSE_HEADER_TIMEOUT=1200
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
GATEWAY_IMAGE_WORKER_ENABLED=false
GATEWAY_IMAGE_WORKER_BASE_URL=http://chatgpt2api:80/internal/v1
GATEWAY_IMAGE_WORKER_TOKEN=replace-with-shared-internal-token
GATEWAY_IMAGE_WORKER_FALLBACK_ENABLED=true
GATEWAY_IMAGE_WORKER_TIMEOUT_SECONDS=1200
IMAGE_JOBS_RETENTION_DAYS=30
